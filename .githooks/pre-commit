#!/bin/sh
# Секретам в репозитории не место (ТЗ §9). Включение: git config core.hooksPath .githooks
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact || {
    echo 'gitleaks нашёл похожее на секрет — коммит остановлен.' >&2
    exit 1
  }
else
  echo 'gitleaks не установлен (brew install gitleaks) — проверка секретов пропущена.' >&2
fi
